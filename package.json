{
  "name": "github-ultimate",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "description": "A comment-powered GitHub PR workspace for human-agent collaboration",
  "license": "MIT",
  "bin": {
    "github-ultimate-form": "bin/github-ultimate-form"
  },
  "scripts": {
    "lint:tsx-view-boundary": "OPENLINT_POLICY_DIR=.github/openlint ol check --preset tsx-view-boundary --target . src hosted webapp/src",
    "lint:tsx-view-boundary:changed": "OPENLINT_POLICY_DIR=.github/openlint ol check --changed --preset tsx-view-boundary --target .",
    "lint:tsx-view-boundary:last-commit": "OPENLINT_POLICY_DIR=.github/openlint ol check --last-commit --preset tsx-view-boundary --target .",
    "lint:ui-customization-fences": "OPENLINT_POLICY_DIR=.github/openlint ol check --preset ui-customization-fences --target . src hosted webapp/src",
    "hosted:build": "node scripts/build-hosted.mjs",
    "hosted:storybook:stage": "node scripts/stage-hosted-storybook.mjs",
    "pages:build": "pnpm run hosted:build && pnpm run webapp:storybook:build && pnpm run hosted:storybook:stage",
    "form": "node --experimental-strip-types cli/form.ts",
    "review": "node --experimental-strip-types cli/review.ts",
    "playground": "vite --config playground/vite.config.ts",
    "storybook": "storybook dev --host 127.0.0.1 --port ${PORT:-6006} --ci --no-open --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry",
    "test:storybook": "playwright test --config playwright.storybook.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "test:playground": "playwright test --config playground/playwright.config.ts",
    "build": "node scripts/build.mjs",
    "build:safari": "node scripts/build.mjs safari",
    "test:mobile": "playwright test --config playwright.mobile.config.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "webapp:dev": "pnpm --dir webapp dev",
    "webapp:build": "pnpm --dir webapp build",
    "webapp:check": "pnpm --dir webapp check",
    "webapp:storybook": "pnpm --dir webapp storybook",
    "webapp:storybook:build": "pnpm --dir webapp storybook:build",
    "test:webapp-storybook": "playwright test --config playwright.webapp-storybook.config.ts",
    "package": "pnpm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "dompurify": "^3.3.0",
    "fast-xml-parser": "^5.12.0",
    "marked": "^17.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@playwright/test": "^1.56.1",
    "@storybook/html-vite": "^10.6.6",
    "@types/chrome": "^0.1.24",
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.2",
    "storybook": "^10.6.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.0.8"
  }
}
