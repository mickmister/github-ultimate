{
  "name": "github-ultimate",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "description": "A comment-powered GitHub PR workspace for human-agent collaboration",
  "license": "MIT",
  "bin": {
    "github-ultimate-form": "bin/github-ultimate-form"
  },
  "scripts": {
    "lint:ui": "ol check --policy-dir .github/openlint --preset ui-mobile-first --target . src hosted webapp/src",
    "lint:ui:changed": "ol check --policy-dir .github/openlint --preset ui-mobile-first --changed --target .",
    "test:ui-policy": "vitest run tests/ui-policy.test.ts tests/presentation-geometry.test.ts",
    "customization:audit": "ast-grep scan --rule .github/openlint/rules/ast-grep/customization-native-controls.yml webapp/src && ast-grep scan --rule .github/openlint/rules/ast-grep/customization-inline-styles.yml webapp/src",
    "lint:tsx-view-boundary": "ast-grep scan --rule .github/openlint/rules/ast-grep/no-intrinsic-jsx-outside-view.yml src hosted webapp/src && ast-grep scan --rule .github/openlint/rules/ast-grep/no-hooks-in-view.yml src hosted webapp/src",
    "lint:tsx-view-boundary:changed": "OPENLINT_POLICY_DIR=.github/openlint ol check --changed --preset tsx-view-boundary --target .",
    "lint:tsx-view-boundary:last-commit": "OPENLINT_POLICY_DIR=.github/openlint ol check --last-commit --preset tsx-view-boundary --target .",
    "lint:ui-customization-fences": "OPENLINT_POLICY_DIR=.github/openlint ol check --preset ui-customization-fences --target . src hosted webapp/src",
    "hosted:build": "node scripts/build-hosted.mjs",
    "pi:build": "node scripts/build-pi.mjs",
    "pi-web:install": "npm --prefix pi-web/client ci --ignore-scripts --no-audit --no-fund",
    "pi-web:build": "node scripts/build-pi-web.mjs",
    "test:pi-web": "playwright test --config playwright.pi-web.config.ts",
    "pi-web:storybook": "npm --prefix pi-web/client run storybook",
    "pi-web:storybook:build": "node scripts/build-pi-web-storybook.mjs",
    "test:pi-web-storybook": "playwright test --config playwright.pi-web-storybook.config.ts",
    "hosted:storybook:stage": "node scripts/stage-hosted-storybook.mjs",
    "pages:build": "pnpm run hosted:build && pnpm run webapp:storybook:build && pnpm run hosted:storybook:stage",
    "form": "node --experimental-strip-types cli/form.ts",
    "review": "node --experimental-strip-types cli/review.ts",
    "playground": "vite --config playground/vite.config.ts",
    "storybook": "storybook dev --host 127.0.0.1 --port ${PORT:-6006} --ci --no-open --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry",
    "test:storybook": "playwright test --config playwright.storybook.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "test:playground": "playwright test --config playground/playwright.config.ts",
    "build": "node scripts/build.mjs",
    "build:safari": "node scripts/build.mjs safari",
    "test:mobile": "playwright test --config playwright.mobile.config.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:tsrs": "playwright test --config playwright.tsrs.config.ts",
    "test:workflows": "playwright test --config playwright.workflows.config.ts",
    "test:runs": "playwright test --config playwright.runs.config.ts",
    "webapp:dev": "pnpm --dir webapp dev",
    "webapp:build": "pnpm --dir webapp build",
    "webapp:check": "pnpm --dir webapp check",
    "webapp:storybook": "pnpm --dir webapp storybook",
    "webapp:storybook:build": "pnpm --dir webapp storybook:build",
    "test:webapp-storybook": "playwright test --config playwright.webapp-storybook.config.ts",
    "package": "pnpm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-codemode": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@noble/hashes": "^2.4.0",
    "@tanstack/query-core": "^5.107.1",
    "apache-arrow": "17.0.0",
    "aws4fetch": "^1.0.20",
    "diff": "8.0.2",
    "dompurify": "^3.3.0",
    "fast-xml-parser": "^5.12.0",
    "fflate": "0.8.3",
    "graphql": "16.11.0",
    "marked": "^17.0.0",
    "protobufjs": "7.5.4",
    "quickjs-wasi": "3.6.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@mickmister/openlint": "0.1.0",
    "@playwright/test": "^1.56.1",
    "@storybook/html-vite": "^10.6.6",
    "@tsrs/wasm": "7.1.0-beta.tsrs5",
    "@types/chrome": "^0.1.24",
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.8",
    "storybook": "^10.6.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.0.8"
  }
}
