{
  "name": "github-ultimate",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "A comment-powered GitHub PR workspace for human-agent collaboration",
  "license": "MIT",
  "bin": {
    "github-ultimate-form": "bin/github-ultimate-form"
  },
  "scripts": {
    "form": "node --experimental-strip-types cli/form.ts",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "test:playground": "playwright test --config playground/playwright.config.ts",
    "build": "node scripts/build.mjs",
    "build:safari": "node scripts/build.mjs safari",
    "test:mobile": "playwright test --config playwright.mobile.config.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "marked": "^17.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/chrome": "^0.1.24",
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.0.8"
  }
}
