{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["chrome", "node", "vite/client"],
    "skipLibCheck": true
  },
  "include": ["src", "cli", "tests", "playground", "playwright.config.ts", "vitest.config.ts"]
}
