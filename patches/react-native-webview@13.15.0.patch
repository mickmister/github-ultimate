+/** App-private opt-in contract. RNWV continues to own the view and browser UI. */
+final class AlohakBridge {
+  private final RNCWebView web;
+  private final String scope;
+  private String documentId = "", documentURL = "";
+  private boolean ready = false;
+  private boolean installed = false;
+  private final Map<String, JavaScriptReplyProxy> pending = new HashMap<>();
+  AlohakBridge(RNCWebView web, String scope) { this.web = web; this.scope = scope; }
+  boolean allowed(String raw) {
+    try {
+      Uri url = Uri.parse(raw), base = Uri.parse(scope);
+      String path = url.getEncodedPath() == null ? "/" : url.getEncodedPath();
+      String prefix = base.getEncodedPath();
+      return raw.length() <= 4096 && !raw.contains("\\") &&
+        !java.util.regex.Pattern.compile("%2f|%5c|%2e|%25", java.util.regex.Pattern.CASE_INSENSITIVE).matcher(path).find() &&
+        "https".equals(url.getScheme()) && url.getUserInfo() == null && url.getHost() != null &&
+        url.getHost().equals(base.getHost()) && url.getPort() == base.getPort() &&
+        "https".equals(base.getScheme()) && prefix != null && prefix.endsWith("/") &&
+        (path.equals(prefix.substring(0, prefix.length() - 1)) || path.startsWith(prefix));
+    } catch (Exception ignored) { return false; }
+  }
+  private void emit(JSONObject event) { web.onMessage(event.toString(), documentURL); }
+  private JSONObject object() { return new JSONObject(); }
+  void invalidate(String state) {
+    pending.clear(); ready = false; documentId = UUID.randomUUID().toString(); documentURL = "";
+    try { emit(object().put("type", "document").put("state", state).put("documentId", documentId).put("documentURL", "")); }
+    catch (Exception ignored) { }
+  }
+  void start(String url) {
+    invalidate("loading");
+    if (!allowed(url)) { web.stopLoading(); invalidate("error"); return; }
+    documentURL = url;
+  }
+  void commit(String url) {
+    if (!installed || !url.equals(documentURL) || !allowed(documentURL)) return;
+    ready = true;
+    try { emit(object().put("type", "document").put("state", "ready").put("documentId", documentId).put("documentURL", documentURL)); }
+    catch (Exception ignored) { }
+  }
+  void install() {
+    if (!WebViewFeature.isFeatureSupported(WebViewFeature.WEB_MESSAGE_LISTENER)) { invalidate("error"); return; }
+    Uri base = Uri.parse(scope);
+    String origin = "https://" + base.getHost() + (base.getPort() < 0 ? "" : ":" + base.getPort());
+    WebViewCompat.addWebMessageListener(web, "alohak", java.util.Collections.singleton(origin), (view, message, source, main, proxy) -> {
+      if (!ready || !main || message.getType() != androidx.webkit.WebMessageCompat.TYPE_STRING) return;
+      String data = message.getData(); Uri expected = Uri.parse(documentURL);
+      if (!ready || !main || !allowed(documentURL) || !"https".equals(source.getScheme()) ||
