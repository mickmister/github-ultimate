+          data == null || data.getBytes(java.nio.charset.StandardCharsets.UTF_8).length > 16384 || pending.size() >= 8) return;
+      String replyId = UUID.randomUUID().toString(); pending.put(replyId, proxy);
+      try { emit(object().put("type", "message").put("documentId", documentId).put("documentURL", documentURL)
+        .put("isMainFrame", true).put("replyId", replyId).put("data", data)); }
+      catch (Exception ignored) { pending.remove(replyId); }
+    });
+    installed = true;
+  }
+  void respond(String input) {
+    try {
+      JSONObject value = new JSONObject(input);
+      JavaScriptReplyProxy proxy = pending.remove(value.getString("replyId"));
+      if (proxy != null && ready && documentId.equals(value.getString("documentId"))) proxy.postMessage(value.getString("data"));
+    } catch (Exception ignored) { }
+  }
+  void bootstrap(String input) {
+    try {
+      JSONObject value = new JSONObject(input);
+      if (ready && documentId.equals(value.getString("documentId"))) web.evaluateJavascriptWithFallback(value.getString("script"));
+    } catch (Exception ignored) { }
+  }
+}
