+#import <WebKit/WebKit.h>
+
+// App-private opt-in contract; RNWV retains ownership of the platform view.
+@interface RNCAlohakBridge : NSObject <WKScriptMessageHandlerWithReply>
+@property(nonatomic, weak) WKWebView *web;
+@property(nonatomic, copy) void (^emit)(NSString *);
+- (instancetype)initWithScope:(NSString *)scope;
+- (BOOL)allowed:(NSString *)url;
+- (void)invalidate:(NSString *)state;
+- (void)start:(WKNavigation *)navigation;
+- (BOOL)response:(WKNavigationResponse *)response;
+- (void)commit:(WKNavigation *)navigation;
+- (void)finish:(WKNavigation *)navigation;
+- (void)fail:(WKNavigation *)navigation;
+- (void)respond:(NSString *)input;
+- (void)bootstrap:(NSString *)input;
+@end
