@@ -0,0 +1,83 @@
+#import "RNCAlohakBridge.h"
+
+@implementation RNCAlohakBridge {
+  NSString *_scope, *_documentId, *_documentURL, *_responseURL;
+  WKNavigation *_navigation;
+  BOOL _ready;
+  NSMutableDictionary<NSString *, id> *_pending;
+}
+- (instancetype)initWithScope:(NSString *)scope {
+  if ((self = [super init])) { _scope = [scope copy]; _pending = [NSMutableDictionary new]; _documentURL = @""; }
+  return self;
+}
+- (BOOL)allowed:(NSString *)raw {
+  if (!raw || raw.length > 4096 || [raw containsString:@"\\"]) return NO;
+  NSURLComponents *url = [NSURLComponents componentsWithString:raw], *base = [NSURLComponents componentsWithString:_scope];
+  NSString *path = url.percentEncodedPath;
+  if (!path || ![base.percentEncodedPath hasSuffix:@"/"]) return NO;
+  NSRegularExpression *encoded = [NSRegularExpression regularExpressionWithPattern:@"%2f|%5c|%2e|%25" options:NSRegularExpressionCaseInsensitive error:nil];
+  return ![encoded firstMatchInString:path options:0 range:NSMakeRange(0, path.length)] &&
+    [url.scheme isEqual:@"https"] && [base.scheme isEqual:@"https"] && !url.user && !url.password &&
+    [url.host isEqual:base.host] && ((!url.port && !base.port) || [url.port isEqual:base.port]) &&
+    ([path isEqual:[base.percentEncodedPath substringToIndex:base.percentEncodedPath.length - 1]] || [path hasPrefix:base.percentEncodedPath]);
+}
+- (void)send:(NSDictionary *)value {
+  NSData *bytes = [NSJSONSerialization dataWithJSONObject:value options:0 error:nil];
+  if (bytes && self.emit) self.emit([[NSString alloc] initWithData:bytes encoding:NSUTF8StringEncoding]);
+}
+- (void)invalidate:(NSString *)state {
+  NSArray *replies = _pending.allValues; [_pending removeAllObjects];
+  _ready = NO; _documentId = NSUUID.UUID.UUIDString; _documentURL = @""; _responseURL = @"";
+  for (id value in replies) { void (^reply)(id, NSString *) = value; reply(nil, @"Document changed."); }
+  [self send:@{@"type": @"document", @"state": state, @"documentId": _documentId, @"documentURL": @""}];
+}
+- (void)start:(WKNavigation *)navigation { [self invalidate:@"loading"]; _navigation = navigation; }
+- (BOOL)response:(WKNavigationResponse *)response {
+  if (!response.forMainFrame) return NO;
+  NSHTTPURLResponse *http = [response.response isKindOfClass:NSHTTPURLResponse.class] ? (NSHTTPURLResponse *)response.response : nil;
+  if (!http || http.statusCode < 200 || http.statusCode >= 300 || !response.canShowMIMEType || ![self allowed:http.URL.absoluteString]) {
+    [self invalidate:@"error"]; return NO;
+  }
+  _responseURL = http.URL.absoluteString; return YES;
+}
+- (void)commit:(WKNavigation *)navigation { if (navigation == _navigation) _documentURL = _responseURL; }
+- (void)finish:(WKNavigation *)navigation {
+  if (navigation != _navigation) return;
+  if (![self allowed:_documentURL]) { [self invalidate:@"error"]; return; }
+  _ready = YES;
+  [self send:@{@"type": @"document", @"state": @"ready", @"documentId": _documentId, @"documentURL": _documentURL}];
+}
+- (void)fail:(WKNavigation *)navigation { if (navigation == _navigation) [self invalidate:@"error"]; }
+- (void)userContentController:(WKUserContentController *)controller didReceiveScriptMessage:(WKScriptMessage *)message replyHandler:(void (^)(id, NSString *))reply {
+  WKSecurityOrigin *origin = message.frameInfo.securityOrigin;
+  NSURL *url = [NSURL URLWithString:_documentURL];
+  if (!_ready || !message.frameInfo.isMainFrame || message.webView != self.web || ![self allowed:_documentURL] ||
+      ![origin.protocol isEqual:@"https"] || ![origin.host isEqual:url.host] || (origin.port ? origin.port : 443) != (url.port ? url.port.integerValue : 443) ||
+      ![message.body isKindOfClass:NSString.class] || [message.body lengthOfBytesUsingEncoding:NSUTF8StringEncoding] > 16384 || _pending.count >= 8) {
+    reply(nil, @"Native document or request unavailable."); return;
+  }
+  NSString *replyId = NSUUID.UUID.UUIDString; _pending[replyId] = [reply copy];
+  [self send:@{@"type": @"message", @"documentId": _documentId, @"documentURL": _documentURL,
+    @"isMainFrame": @YES, @"replyId": replyId, @"data": message.body}];
+}
+- (NSDictionary *)parse:(NSString *)input {
+  id value = [NSJSONSerialization JSONObjectWithData:[input dataUsingEncoding:NSUTF8StringEncoding] options:0 error:nil];
+  return [value isKindOfClass:NSDictionary.class] ? value : nil;
+}
+- (void)respond:(NSString *)input {
+  NSDictionary *value = [self parse:input]; NSString *key = value[@"replyId"];
+  if (![key isKindOfClass:NSString.class]) return;
+  void (^reply)(id, NSString *) = _pending[key]; [_pending removeObjectForKey:key];
+  if (!reply) return;
+  if (_ready && [_documentId isEqual:value[@"documentId"]] && [value[@"data"] isKindOfClass:NSString.class]) reply(value[@"data"], nil);
+  else reply(nil, @"Document changed.");
+}
+- (void)bootstrap:(NSString *)input {
+  NSDictionary *value = [self parse:input];
+  if (_ready && [_documentId isEqual:value[@"documentId"]] && [value[@"script"] isKindOfClass:NSString.class])
+    [self.web evaluateJavaScript:value[@"script"] completionHandler:nil];
+}
+- (void)dealloc {
+  for (id value in _pending.allValues) { void (^reply)(id, NSString *) = value; reply(nil, @"WebView disposed."); }
+}
+@end
