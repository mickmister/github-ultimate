{
  "features": [{
    "id": "reviews",
    "host": "webapp/src/features/reviews/ReviewWorkspace.tsx",
    "hooks": "webapp/src/features/reviews/ReviewWorkspace.hooks.ts",
    "hook": "useReviewWorkspaceFeature",
    "copy": "webapp/src/features/reviews/Reviews.copy.ts",
    "ownedViews": [
      "webapp/src/features/reviews/ReviewWorkspace.view.tsx",
      "webapp/src/features/reviews/ReviewPacket.view.tsx",
      "webapp/src/features/reviews/ReviewSession.view.tsx",
      "webapp/src/features/reviews/ReviewsInboxParts.view.tsx"
    ],
    "presentations": [
      { "id": "reviews.inbox", "kind": "page", "file": "webapp/src/features/reviews/ReviewsInbox.presentation.tsx", "export": "ReviewsInboxPresentation" },
      { "id": "reviews.detail", "kind": "region", "file": "webapp/src/features/reviews/ReviewsDetail.presentation.tsx", "export": "ReviewsDetailPresentation" }
    ],
    "scenarios": "webapp/stories/ReviewsDetailSurfaces.stories.tsx"
  }],
  "routes": {
    "webapp/src/routes/reviews.tsx": { "feature": "reviews" },
    "webapp/src/routes/reviews.$requestId.tsx": { "feature": "reviews", "parent": "webapp/src/routes/reviews.tsx" }
  },
  "removeLegacyRoutes": ["webapp/src/routes/reviews.tsx", "webapp/src/routes/reviews.$requestId.tsx"]
}
