{
  "cli": { "version": "27.7.2", "appVersionSource": "remote" },
  "build": {
    "base": {
      "node": "22.23.0",
      "pnpm": "12.18.0",
      "autoIncrement": true
    },
    "development": {
      "extends": "base",
      "environment": "development",
      "channel": "development",
      "distribution": "internal",
      "developmentClient": true,
      "android": { "buildType": "apk" }
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "channel": "preview",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "channel": "production",
      "distribution": "store"
    }
  }
}
