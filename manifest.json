{
  "manifest_version": 3,
  "name": "GitHub Ultimate",
  "version": "0.1.1",
  "description": "Forms, bead progress and saved workflow sessions directly in your GitHub PR workspace.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "connections.html", "open_in_tab": true },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png",
    "1024": "icons/icon-1024.png"
  },
  "content_scripts": [{
    "matches": ["https://github.com/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "action": { "default_popup": "popup.html", "default_title": "GitHub Ultimate settings" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
