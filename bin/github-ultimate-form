#!/usr/bin/env node
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
// import.meta.url resolves the real package location even through npm link.
const result = spawnSync(process.execPath, ['--experimental-strip-types', fileURLToPath(new URL('../cli/form.ts', import.meta.url)), ...process.argv.slice(2)], { stdio: 'inherit' });
if (result.error) console.error(`github-ultimate-form: ${result.error.message}`);
process.exitCode = result.status ?? 1;
